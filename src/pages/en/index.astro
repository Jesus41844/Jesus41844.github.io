---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RoleItem from '../../components/RoleItem.astro';
import CertificateItem from '../../components/CertificateItem.astro';
import About from '../../components/About.astro';
import { copy, links, type Locale } from '../../lib/i18n';
import { projectColor, type ColorName } from '../../lib/palette';

const locale: Locale = 'en';
const t = copy[locale];

const projects = (await getCollection('projects', ({ data }) => data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.data);

const rolesRaw = (await getCollection('experience', ({ data }) => data.locale === locale))
  .map((r) => ({ ...r.data, detail: r.body?.trim() }))
  .sort((a, b) => a.order - b.order);

const participaciones = (
  await getCollection('participaciones', ({ data }) => data.locale === locale)
)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.data);

const certificaciones = (
  await getCollection('certificaciones', ({ data }) => data.locale === locale)
)
  .sort((a, b) => a.data.order - b.data.order)
  .map((c) => c.data);

/** Los conteos se calculan. Escribirlos a mano en i18n es un bug esperando:
 *  anadir una participacion y olvidar el numero no da error, solo miente. */
const n = (x: number) => ` · ${String(x).padStart(2, '0')}`;

const about = (await getCollection('about', ({ data }) => data.locale === locale)).map(
  (a) => a.data,
)[0];

/** Short project title per color, for the grid legend. */
const names = Object.fromEntries(
  projects.map((p) => [projectColor[p.id] as ColorName, p.title]),
) as Record<ColorName, string>;

const description =
  'Portfolio of Jesús de Gracia, software developer in Panama, third-year Systems and Computer Engineering student. Four applications in real use, two with public demos. Looking for an internship in robotics, AI or ML, from February 2027.';
---

<Base locale={locale} title={`${t.name} — ${t.role}`} description={description}>
  <Hero locale={locale} names={names} />

  <section id="projects" class="band">
    <h2 class="band-label">{t.projectsLabel}{n(projects.length)}</h2>
    <p class="band-intro">{t.projectsIntro}</p>
    {
      projects.map((p) => (
        <ProjectCard
          title={p.title}
          tagline={p.tagline}
          problem={p.problem}
          highlights={p.highlights}
          stack={p.stack}
          repo={p.repo}
          demo={p.demo}
          footnote={p.footnote}
          image={p.image}
          imageCaption={p.imageCaption}
          imageFit={p.imageFit}
          color={projectColor[p.id] as ColorName}
          status={p.status}
          demoLabel={t.demo}
          codeLabel={t.code}
          noDemoLabel={t.noDemo}
          shotCaption={t.shotCaption}
          noShot={t.noShot}
          stackLabel={t.stackLabel}
        />
      ))
    }
  </section>

  {/* La banda de experiencia se parte en dos. Los cargos no son todos lo mismo:
      tres son de agrupación o congreso y uno es un empleo con nómina. El id se
      queda en la primera porque el nav apunta ahí; la segunda cuelga debajo. */}
  <section id="experience" class="band">
    <h2 class="band-label">{t.orgLabel}{n(rolesRaw.filter((r) => r.track === 'organizaciones').length)}</h2>
    <p class="band-intro">{t.orgIntro}</p>
    {rolesRaw.filter((r) => r.track === 'organizaciones').map((r) => <RoleItem {...r} />)}
  </section>

  <section id="work" class="band">
    <h2 class="band-label">{t.workLabel}{n(rolesRaw.filter((r) => r.track === 'laboral').length)}</h2>
    <p class="band-intro">{t.workIntro}</p>
    {rolesRaw.filter((r) => r.track === 'laboral').map((r) => <RoleItem {...r} />)}
  </section>

  {participaciones.length > 0 && (
    <section id="participaciones" class="band">
      <h2 class="band-label">{t.partLabel}{n(participaciones.length)}</h2>
      <p class="band-intro">{t.partIntro}</p>
      <div class="role-list">
        {participaciones.map((p) => (
          <article class="part">
            {p.images && p.images.length > 0 && (
              /* Una foto sola se muestra grande; varias van en una rejilla de
                 celdas iguales. Lo que no vuelve es una foto grande con el
                 resto en miniatura: ese salto de tamaño era lo que se veía
                 raro, no el hecho de que hubiera varias. */
              p.images.length === 1 ? (
                <figure class="part-shot part-shot--tall">
                  <img
                    src={p.images[0].src}
                    alt={`${p.org}: ${p.role}`}
                    loading="lazy"
                    decoding="async"
                    style={p.images[0].fit ? `object-fit:${p.images[0].fit}` : undefined}
                  />
                  {p.images[0].caption && <figcaption>{p.images[0].caption}</figcaption>}
                </figure>
              ) : (
                <div class="part-strip" style={`--n:${p.images.length}`}>
                  {p.images.map((im) => (
                    <figure class="part-thumb">
                      <img
                        src={im.src}
                        alt={`${p.org}: ${im.caption ?? p.role}`}
                        loading="lazy"
                        decoding="async"
                        style={im.fit ? `object-fit:${im.fit}` : undefined}
                      />
                      {!p.caption && im.caption && <figcaption>{im.caption}</figcaption>}
                    </figure>
                  ))}
                  {p.caption && <p class="part-strip-cap">{p.caption}</p>}
                </div>
              )
            )}
            <div class="part-when">
              <p class="part-period">{p.period}</p>
              {p.kind && <p class="part-kind">{p.kind}</p>}
            </div>
            <div class="part-what">
              <h3 class="part-role">{p.role}</h3>
              <p class="part-org">{p.org}</p>
              <p class="part-body">{p.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {certificaciones.length > 0 && (
    <section id="certificaciones" class="band">
      <h2 class="band-label">{t.certLabel}{n(certificaciones.length)}</h2>
      <p class="band-intro">{t.certIntro}</p>
      <div class="role-list">
        {certificaciones.map((c) => (
          <CertificateItem name={c.name} issuer={c.issuer} date={c.date} hours={c.hours} kind={c.kind} credential={c.credential} />
        ))}
      </div>
    </section>
  )}

  {about && <About locale={locale} lead={about.lead} body={about.body} />}

  <section id="contact" class="band">
    <h2 class="band-label">{t.contactLabel}</h2>
    <p class="band-intro">{t.contactBody}</p>
    <dl class="spec">
      <div class="spec-row">
        <dt>GitHub</dt>
        <dd><a href={links.github} target="_blank" rel="noopener noreferrer">{links.githubHandle}</a></dd>
      </div>
      <div class="spec-row">
        <dt>LinkedIn</dt>
        <dd><a href={links.linkedin} target="_blank" rel="noopener noreferrer">{links.linkedinHandle}</a></dd>
      </div>
    </dl>
  </section>
</Base>
