---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RoleItem from '../../components/RoleItem.astro';
import { copy, type Locale } from '../../lib/i18n';

const locale: Locale = 'en';
const t = copy[locale];

const projects = (await getCollection('projects', ({ data }) => data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.data);

const roles = (await getCollection('experience', ({ data }) => data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order)
  .map((r) => ({ ...r.data, detail: r.body?.trim() }));

const STACK = [
  'TypeScript',
  'Python',
  'Next.js',
  'React',
  'Flask',
  'FastAPI',
  'PostgreSQL',
  'Prisma',
  'Drizzle',
  'SQLAlchemy',
  'Docker',
  'Tailwind',
  'Supabase',
  'Vercel',
  'GitHub Actions',
  'vitest',
  'pytest',
];
---

<Base
  locale={locale}
  title={`${t.name} — ${t.role}`}
  description="Portfolio of Jesús de Gracia, software developer in Panama. Four applications in real use, with live demos."
>
  <Hero
    name={t.name}
    role={t.role}
    location={t.location}
    summary={t.summary}
    ctaRepo={t.ctaRepo}
    ctaLinkedin={t.ctaLinkedin}
  />

  <section id="projects">
    <div class="sec-head">
      <h2>{t.projectsTitle}</h2>
      <p>{t.projectsIntro}</p>
    </div>
    {
      projects.map((p) => (
        <ProjectCard
          title={p.title}
          tagline={p.tagline}
          problem={p.problem}
          highlights={p.highlights}
          stack={p.stack}
          repo={p.repo}
          demo={p.demo}
          footnote={p.footnote}
          demoLabel={t.demo}
          codeLabel={t.code}
        />
      ))
    }
  </section>

  <section id="experience">
    <div class="sec-head">
      <h2>{t.experienceTitle}</h2>
      <p>{t.experienceIntro}</p>
    </div>
    {roles.map((r) => <RoleItem {...r} />)}
  </section>

  <section id="stack">
    <div class="sec-head">
      <h2>{t.stackTitle}</h2>
      <p>{t.stackIntro}</p>
    </div>
    <div class="stack-list">
      {STACK.map((s) => <span class="tag">{s}</span>)}
    </div>
  </section>

  <section id="contact">
    <div class="sec-head">
      <h2>{t.contactTitle}</h2>
    </div>
    <div class="contact-box">
      <p>{t.contactBody}</p>
      <div class="cta">
        <a
          class="btn btn-primary"
          href="https://www.linkedin.com/in/jesus-de-gracia-a1750a230/"
          rel="me">LinkedIn</a
        >
        <a class="btn" href="https://github.com/Jesus41844">GitHub</a>
      </div>
    </div>
  </section>
</Base>
