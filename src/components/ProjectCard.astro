---
import type { ColorName } from '../lib/palette';

interface Props {
  title: string;
  tagline: string;
  problem: string;
  highlights: string[];
  stack: string[];
  repo: string;
  demo?: string;
  footnote?: string;
  color: ColorName;
  status: string;
  demoLabel: string;
  codeLabel: string;
  noDemoLabel: string;
}

const {
  title,
  tagline,
  problem,
  highlights,
  stack,
  repo,
  demo,
  footnote,
  color,
  status,
  demoLabel,
  codeLabel,
  noDemoLabel,
} = Astro.props;
---

<article class="project" data-project={color}>
  <div class="project-head">
    <h3 class="project-title">{title}</h3>
    <p class="project-tagline">{tagline}</p>
    <p class="project-status">{status}</p>
  </div>

  <p class="project-problem">{problem}</p>

  <ul class="project-points">
    {highlights.map((h) => <li>{h}</li>)}
  </ul>

  <p class="project-stack">
    {stack.map((s, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">/</span>}
        <span>{s}</span>
      </>
    ))}
  </p>

  <p class="project-links">
    {
      demo ? (
        <a class="link-go" href={demo}>
          {demoLabel} <span class="arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="link-off">{noDemoLabel}</span>
      )
    }
    <a class="link-go" href={repo} rel="noopener">
      {codeLabel} <span class="arrow" aria-hidden="true">→</span>
    </a>
  </p>

  {footnote && <p class="project-footnote">{footnote}</p>}
</article>
