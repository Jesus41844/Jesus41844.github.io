---
import type { ColorName } from '../lib/palette';

interface Props {
  title: string;
  tagline: string;
  problem: string;
  highlights: string[];
  stack: string[];
  repo: string;
  demo?: string;
  footnote?: string;
  image?: string;
  imageCaption?: string;
  imageFit?: 'cover' | 'contain';
  color: ColorName;
  status: string;
  demoLabel: string;
  codeLabel: string;
  noDemoLabel: string;
  shotCaption: string;
  noShot: string;
  stackLabel: string;
}

const {
  title,
  tagline,
  problem,
  highlights,
  stack,
  repo,
  demo,
  footnote,
  image,
  imageCaption,
  imageFit,
  color,
  status,
  demoLabel,
  codeLabel,
  noDemoLabel,
  shotCaption,
  noShot,
  stackLabel,
} = Astro.props;
---

<article class="project" data-project={color}>
      <div class="project-head">
        <h3 class="project-title">{title}</h3>
        <p class="project-tagline">{tagline}</p>
        <p class="project-status">{status}</p>
      </div>

      {/* La descripcion va antes que la captura en el DOM: en el grid de
          escritorio se placingan en columna propia al lado de la imagen, y en
          una sola columna caen en este orden, que es el que se lee. */}
      <p class="project-problem">{problem}</p>


  <figure class="project-shot">
    {
      image ? (
        <>
          <img
            src={image}
            alt={`${title}: captura de la aplicación`}
            loading="lazy"
            decoding="async"
            style={`object-fit:${imageFit ?? 'cover'};object-position:left top`}
          />
          <figcaption>{imageCaption ?? shotCaption}</figcaption>
        </>
      ) : (
        <>
          <div class="shot-empty" aria-hidden="true" />
          <figcaption>{noShot}</figcaption>
        </>
      )
    }
  </figure>

  <ul class="project-points">
    {highlights.map((h) => <li>{h}</li>)}
  </ul>

  <div class="project-stack">
    <span class="project-stack-label">{stackLabel}</span>
    <ul class="chips">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>

  <p class="project-links">
    {
      demo ? (
        <a class="link-go" href={demo} target="_blank" rel="noopener noreferrer">
          {demoLabel} <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ) : (
        <span class="link-off">{noDemoLabel}</span>
      )
    }
    <a class="link-go" href={repo} target="_blank" rel="noopener noreferrer">
      {codeLabel} <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </p>

  {footnote && <p class="project-footnote">{footnote}</p>}
</article>
