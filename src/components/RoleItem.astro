---
interface Props {
  role: string;
  org: string;
  period: string;
  kind?: string;
  place?: string;
  body: string;
  /** Parrafo que describe lo que construiste para el cargo. */
  detail?: string;
  images?: { src: string; caption?: string; fit?: 'cover' | 'contain' }[];
}

const { role, org, period, kind, place, body, detail, images } = Astro.props;
const cover = images?.[0];
const rest = images?.slice(1) ?? [];

const meta = [kind, place].filter(Boolean).join(' · ');
---

<article class="role">
  <div class="role-when">
    <p class="role-period">{period}</p>
    {meta && <p class="role-meta">{meta}</p>}
  </div>

  <div class="role-what">
    {cover && (
      <>
        <figure class="role-shot">
          <img
            src={cover.src}
            alt={`${org}: ${role}`}
            loading="lazy"
            decoding="async"
            style={cover.fit ? `object-fit:${cover.fit}` : undefined}
          />
          {cover.caption && <figcaption>{cover.caption}</figcaption>}
        </figure>
        {rest.length > 0 && (
          <div class="part-strip">
            {rest.map((im) => (
              <figure class="part-thumb">
                <img
                  src={im.src}
                  alt={`${org}: ${im.caption ?? role}`}
                  loading="lazy"
                  decoding="async"
                  style={im.fit ? `object-fit:${im.fit}` : undefined}
                />
                {im.caption && <figcaption>{im.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </>
    )}
    <h3 class="role-title">{role}</h3>
    <p class="role-org">{org}</p>
    <p class="role-body">{body}</p>
    {detail && <p class="role-detail">{detail}</p>}
  </div>
</article>
